# Copy to .env and fill in real values. NEVER commit .env.
GROQ_API_KEY=your_groq_key_here
PINECONE_API_KEY=your_pinecone_key_here

# Optional overrides
PINECONE_INDEX_NAME=multimodal-vrag
PINECONE_NAMESPACE=demo
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

PDF_PATH=data/HPSAs by Score .pdf
IMAGE_DIR=extracted_image
CACHE_DIR=cache

# Model tiers
MODEL_CHEAP=llama-3.1-8b-instant
MODEL_MID=openai/gpt-oss-20b
MODEL_FRONTIER=openai/gpt-oss-120b
MODEL_VISION=meta-llama/llama-4-scout-17b-16e-instruct
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=BAAI/bge-reranker-base

# Compaction / budget
RETRIEVAL_TOP_K=10
RERANK_TOP_N=5
CONTEXT_TOKEN_BUDGET=3000

# Confidence: off | fast | full
CONFIDENCE_MODE=fast
CONFIDENCE_HIGH=0.75
CONFIDENCE_LOW=0.50

# Logging
LOG_LEVEL=INFO
LOG_JSON=false

# Safety
REQUEST_TIMEOUT_SECS=60
MAX_QUESTION_CHARS=1000
MIN_IMAGE_BYTES=5000
MIN_IMAGE_DIM=100

# API server
API_HOST=127.0.0.1
API_PORT=8000
API_KEY=
ALLOWED_ORIGINS=*
